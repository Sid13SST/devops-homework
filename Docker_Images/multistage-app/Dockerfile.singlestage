# Single-stage build - the whole Go toolchain stays in the final image.
# This exists only as a size comparison against the multi-stage Dockerfile.
FROM golang:1.23-alpine

WORKDIR /src
COPY go.mod ./
COPY main.go ./
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /src/server main.go

EXPOSE 8080

CMD ["/src/server"]
